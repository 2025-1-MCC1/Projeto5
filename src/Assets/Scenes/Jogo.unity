MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1886419830}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb66c2c71faf5134eab9252d48befd34, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Policial
  beforeMissionLines:
  - "Bom dia, voc\xEA poderia nos ajudar?"
  - "Tem uma empresa que vive espalhando lixo por ai, e as lixeiras n\xE3o est\xE3o
    aguentando de tanto lixo."
  - "Voc\xEA sabe alguma forma de facilitar a coleta do lixo?"
  - "Sensores seriam uma \xF3tima ideia! N\xF3s podemos come\xE7ar a implementa-los
    naquelas lixeiras do outro lado da rua!"
  afterMissionLines:
  - "Muito obrigada!!\nAgora a coleta de lixo ser\xE1 muito mais f\xE1cil com esses
    sensores."
  - "Aproveitando que voc\xEA me ajudou, conseguiria conversar com a mo\xE7a do outro
    lado da rua?"
  - Ela estava com algum problema envolvendo os postes...
  dialoguePanel: {fileID: 1891846618}
  nameText: {fileID: 906558877}
  dialogueText: {fileID: 48815159}
  missionCompleted: 0
